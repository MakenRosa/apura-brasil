{
  "name": "apura-brasil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Central local de acompanhamento da apuração eleitoral com dados oficiais do TSE",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.mjs",
    "open": "node scripts/start-local.mjs",
    "stop": "node scripts/stop-local.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
